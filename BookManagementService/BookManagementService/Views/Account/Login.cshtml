@{
    ViewData["Title"] = "Login";
    Layout = null;
}
@model LoginModel
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] -QuoteToCash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookManagementService.styles.css" asp-append-version="true" />
</head>
<body>
<form method="post">
    <br /><br />
        <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="text-center">Login</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label for="username">Username</label>
                            <input type="text" class="form-control" asp-for="username" id="username" placeholder="Enter your username" />
                            <span asp-validation-for="username" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" class="form-control" asp-for="password" id="password" placeholder="Enter your password" />
                            <span asp-validation-for="password" class="text-danger"></span>
                        </div> <br /><br />
                        <button type="submit" class="btn btn-primary btn-block">Login</button>
                    </div>
                    <div class="card-footer text-center">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-link">Create a new account?</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
</body>
</html>
<script>
    function clearRegisterForm() {
        document.getElementById('loginForm').reset();
    }
</script>