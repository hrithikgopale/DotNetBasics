
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
@model User
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookManagementService</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookManagementService.styles.css" asp-append-version="true" />
</head>
<body>
<h1 class="text-center">Register</h1>

<form method="post" class="container mt-5" id="registerForm">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="text-center">Create Account</h3>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="Name">Name</label>
                        <input type="text" class="form-control" asp-for="Name" id="Name" placeholder="Enter your full name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="Email">Email</label>
                        <input type="email" class="form-control" asp-for="Email" id="Email" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="Password">Password</label>
                        <input type="password" class="form-control" asp-for="Password" id="Password" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="Phone">Phone</label>
                        <input type="text" class="form-control" asp-for="Phone" id="Phone" placeholder="Enter your phone number" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div> <br /> <br />
                    <button type="submit" class="btn btn-primary btn-block" onclick="clearRegisterForm()">Save</button>
                </div>
            </div>
        </div>
    </div>
</form>
</body>
</html>
   <script>
    function clearLoginForm() {
        document.getElementById('registerForm').reset();
    }
</script>